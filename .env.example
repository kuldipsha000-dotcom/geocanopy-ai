# ─────────────────────────────────────────────────────
#  GeoCanopy AI — Environment Variables
#  Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────

# ── Firebase Realtime Database ────────────────────────
# Get these from: Firebase Console → Project Settings → Your Apps → Web App
# Steps:
#   1. https://console.firebase.google.com → Add project → "geocanopy-ai"
#   2. Realtime Database → Create Database → asia-southeast1 → Test mode
#   3. Project Settings → Web app (</>) → Register → Copy config below

VITE_FIREBASE_API_KEY=YOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# ── Gemini AI (already configured if working) ─────────
# VITE_GEMINI_API_KEY=your_gemini_key
